```gitignore
# =========================
# Python
# =========================

.venv/
venv/
env/

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/

# =========================
# Node / React / Electron
# =========================

node_modules/

dist/
build/
out/
release/

.webpack/
.vite/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# Environment / Secrets
# =========================

.env
.env.*
!.env.example

*.key
*.pem

# =========================
# Local AI Models
# =========================

models/
*.gguf
*.safetensors
*.bin
*.onnx

# Hugging Face cache
.cache/
huggingface/

# =========================
# Jarvis Runtime Data
# =========================

*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

logs/
*.log

# Temporary generated/runtime files
tmp/
temp/

# =========================
# IDE / Editor
# =========================

.vscode/
.idea/

*.swp
*.swo

# =========================
# Operating System
# =========================

.DS_Store
Thumbs.db
desktop.ini

# =========================
# Miscellaneous
# =========================

*.tmp
*.bak
*.cache
```
